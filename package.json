{
  "name": "code-agent",
  "version": "0.3.0",
  "private": true,
  "description": "CLI coding agent with controlled execution (plan mode + permission checks).",
  "type": "module",
  "imports": {
    "#src/*": {
      "source": "./src/*",
      "default": "./dist/*"
    }
  },
  "bin": {
    "ca": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "NODE_OPTIONS='--conditions=source' tsx src/cli/index.ts",
    "dev:debug": "CODE_AGENT_DEBUG=1 NODE_OPTIONS='--conditions=source' tsx src/cli/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "start": "node dist/cli/index.js",
    "start:debug": "CODE_AGENT_DEBUG=1 node dist/cli/index.js",
    "test": "node --conditions=source --loader tsx --test tests/**/*.test.ts",
    "test:integration": "node --conditions=source --loader tsx --test tests/integration/**/*.test.ts",
    "test:unit": "node --conditions=source --loader tsx --test tests/unit/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
