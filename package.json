{
  "name": "code-agent",
  "version": "0.2.0",
  "private": true,
  "description": "CLI agent that can read local project files through tool calling.",
  "type": "module",
  "bin": {
    "ca": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/index.ts",
    "dev:debug": "CODE_AGENT_DEBUG=1 tsx src/cli/index.ts",
    "format": "biome format --write src",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "start": "node dist/cli/index.js",
    "start:debug": "CODE_AGENT_DEBUG=1 node dist/cli/index.js",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:integration": "node --import tsx --test tests/integration/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/unit/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.2",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
